# Al Gurg Furniture Group | Operations Portal - environment configuration
#
# This file is loaded automatically by Next.js and Prisma.
# Copy values from .env.example for production deployment and replace with real secrets.

# ---------- DATABASE ----------
# SQLite (development default)
DATABASE_URL=file:/home/z/my-project/db/custom.db
# PostgreSQL (production) - uncomment and set your connection string
# DATABASE_URL=postgresql://username:password@host:5432/algurg_operations
# Then change provider in prisma/schema.prisma to "postgresql" and run bun run db:push

# ---------- AUTHENTICATION ----------
# Required for NextAuth JWT signing. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=dev-only-secret-please-replace-in-production-with-openssl-rand-base64-32
# Public URL of the deployment. Used by NextAuth for callbacks.
NEXTAUTH_URL=http://localhost:3000

# ---------- SMTP (outbound email) ----------
# Configure to enable real outbound email for order release, LPO and QC report notifications.
# When unset, emails are logged to EmailLog table only (no network call).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM=Al Gurg Operations <ops@algurgfurniture.ae>

# ---------- FILE UPLOADS ----------
# Files are stored under public/uploads by default.
# For production, swap the local fs write in src/app/api/upload/route.ts for your
# object storage SDK (S3, GCS, Azure Blob) and set the bucket credentials here.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
